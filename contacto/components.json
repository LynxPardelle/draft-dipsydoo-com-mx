{
  "version": 1,
  "domain": "dipsydoo.com.mx",
  "pageId": "contacto",
  "components": [
    {
      "id": "introKicker",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "Dudas, cupos y primera visita",
        "styles": {
          "margin": "0",
          "fontWeight": "800",
          "fontSize": "13px",
          "letterSpacing": ".13em",
          "textTransform": "uppercase",
          "color": "#004d9d"
        }
      }
    },
    {
      "id": "pageHeading",
      "type": "text",
      "config": {
        "tag": "h1",
        "text": "¿Qué te gustaría bailar?",
        "styles": {
          "margin": "0",
          "fontWeight": "700",
          "fontFamily": "Georgia, serif",
          "fontSize": "clamp(33px, 5vw, 64px)",
          "lineHeight": "1.06",
          "letterSpacing": "-.045em",
          "marginBlock": "10px 16px"
        }
      }
    },
    {
      "id": "introDescription",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "Cuéntanos qué estilo, horario o sede te interesa. Te ayudamos a encontrar un grupo.",
        "styles": {
          "margin": "0",
          "fontWeight": "400",
          "fontSize": "clamp(17px, 2vw, 21px)",
          "maxWidth": "57ch"
        }
      }
    },
    {
      "id": "pageIntroLayout",
      "type": "container",
      "config": {
        "tag": "div",
        "components": [
          "introKicker",
          "pageHeading",
          "introDescription"
        ],
        "styles": {
          "width": "min(100%, 1160px)",
          "margin": "0 auto",
          "boxSizing": "border-box",
          "paddingInline": "clamp(20px, 6vw, 76px)",
          "paddingBlock": "clamp(40px, 6vw, 76px)"
        }
      }
    },
    {
      "id": "pageIntro",
      "type": "container",
      "config": {
        "tag": "section",
        "components": [
          "pageIntroLayout"
        ],
        "styles": {
          "background": "linear-gradient(115deg, #ffdfc7, #f6d9ef 54%, #deb6d7)",
          "borderBlock": "1px solid #decddd"
        }
      }
    },
    {
      "id": "contactHeading",
      "type": "text",
      "config": {
        "tag": "h2",
        "text": "Escríbenos por WhatsApp",
        "styles": {
          "margin": "0",
          "fontWeight": "700",
          "fontFamily": "Georgia, serif",
          "fontSize": "clamp(27px, 4vw, 42px)",
          "lineHeight": "1.06",
          "letterSpacing": "-.045em"
        }
      }
    },
    {
      "id": "contactDetails",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "Indícanos el grupo que te interesa. Te podemos confirmar el cupo y el punto de encuentro.",
        "styles": {
          "margin": "0",
          "fontWeight": "400",
          "marginBlock": "10px 18px"
        }
      }
    },
    {
      "id": "whatsapp",
      "type": "link",
      "config": {
        "text": "Abrir WhatsApp ↗",
        "href": "https://wa.me/525585657947?text=Hola%2C%20Dipsy%20Doo!%20Me%20gustar%C3%ADa%20saber%20qu%C3%A9%20grupos%20tienen%20disponibles.",
        "styles": {
          "display": "inline-flex",
          "alignItems": "center",
          "minHeight": "44px",
          "boxSizing": "border-box",
          "color": "white",
          "fontWeight": "700",
          "padding": "12px 20px",
          "borderRadius": "28px",
          "background": "#004d9d",
          "textDecoration": "none"
        }
      }
    },
    {
      "id": "contactSchedule",
