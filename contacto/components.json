        }
      }
    },
    {
      "id": "faqHeading",
      "type": "text",
      "config": {
        "tag": "h2",
        "text": "Antes de tu primera clase",
        "styles": {
          "margin": "0",
          "fontWeight": "700",
          "fontFamily": "Georgia, serif",
          "fontSize": "clamp(27px, 4vw, 42px)",
          "lineHeight": "1.06",
          "letterSpacing": "-.045em"
        }
      }
    },
    {
      "id": "questions",
      "type": "accordion",
      "config": {
        "mode": "multiple",
        "items": [
          {
            "id": "partner",
            "title": "¿Puedo ir sin pareja?",
            "content": "Sí. En clase se hace rotación de pareja."
          },
          {
            "id": "experience",
            "title": "¿Puedo empezar si nunca he bailado?",
            "content": "Sí. Puedes incorporarte desde nivel principiante."
          },
          {
            "id": "observe",
            "title": "¿Puedo observar una clase?",
            "content": "Sí. Escribe por WhatsApp para preguntar por el grupo y el punto de encuentro."
          },
          {
            "id": "single",
            "title": "¿Puedo pagar una sola clase?",
            "content": "Las clases se manejan por mensualidad."
          }
        ],
        "defaultItemContainerClasses": "ank-borderBottom-1px__solid__HASHdecddd",
        "defaultItemButtonConfig": {
          "classes": "ank-display-flex ank-width-100per ank-padding-14px ank-bg-transparent ank-color-HASH004d9d ank-border-0 ank-textAlign-left ank-fontWeight-700"
        },
        "defaultItemPanelClasses": "ank-padding-14px"
      }
    },
